<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<ServerGarbageCollection>true</ServerGarbageCollection>
		<ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
		<TieredPGO>true</TieredPGO>
		<AssemblyName>botswarm</AssemblyName>
		<RootNamespace>BotSwarm</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
	</ItemGroup>

	<ItemGroup>
		<!-- Type and method identities hash with the engine's own XxHash3, which doesn't match System.IO.Hashing -->
		<Compile Include="..\..\Sandbox.System\Utility\Hashing\*.cs" LinkBase="Engine" />
	</ItemGroup>

</Project>
